# Variables de entorno para desarrollo local y despliegue en Netlify
# Copia este archivo como .env en local. En Netlify configuralas desde Site configuration -> Environment variables.
# Nota AWS Lambda: el tamano combinado de todas las variables no debe superar 4 KB (~3 KB maximo recomendado).

NODE_ENV=production
SITE_URL=https://shopuniverses.com

# Credenciales del panel administrativo (/admin)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CambiaEstaClaveSegura2026!

# Secretos criptograficos de sesion y ruleta (usa cadenas aleatorias largas distintas)
SESSION_SECRET=reemplazar-por-secreto-aleatorio-de-32-caracteres
SPIN_SECRET=reemplazar-por-otro-secreto-aleatorio-de-32-caracteres

# Firebase Admin SDK (en local puedes usar FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json)
FIREBASE_PROJECT_ID=shopuniverses-inventario
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@shopuniverses-inventario.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPEGA_AQUI_LA_LLAVE\n-----END PRIVATE KEY-----\n"

# Pasarela de pagos Wompi (opcional hasta activar pagos online)
# En sandbox usar llaves con prefijo pub_test_ / prv_test_ / test_integrity_ / test_events_.
# En produccion cambiar WOMPI_ENV=production y usar llaves prod_.
# URL de Eventos a registrar en Wompi: https://<tu-dominio>/api/payments/wompi/webhook
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Datos del comercio y WhatsApp
STORE_NAME=ShopUniverses
STORE_EMAIL=contacto@tudominio.com
STORE_CITY=Bogotá D.C.
STORE_NIT=
STORE_ADDRESS=Colombia
WHATSAPP_NUMBER=573001234567
