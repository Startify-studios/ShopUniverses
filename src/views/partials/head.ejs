<%
  const pageTitle = title ? `${title} | ${store.name}` : store.name;
  const pageDesc = locals.metaDescription || locals.seo?.description || `${store.name} - Tienda online en Colombia.`;
  const canonicalUrl = locals.seo?.canonicalUrl || '';
  const ogImage = locals.seo?.ogImage || '/assets/img/perfil/2.webp';
  const shouldNoIndex = Boolean(locals.noindex || locals.seo?.noindex);
  const storeLdJson = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Store',
    name: store.name,
    url: locals.seo?.origin || canonicalUrl || undefined,
    logo: ogImage,
    email: store.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: store.city,
      addressCountry: 'CO',
    },
    currenciesAccepted: 'COP',
    creator: {
      '@type': 'Organization',
      name: 'Startify',
      url: 'https://startify.com.co',
    },
  });
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDesc %>">
    <% if (shouldNoIndex) { %>
    <meta name="robots" content="noindex, nofollow">
    <% } else { %>
    <meta name="robots" content="index, follow">
    <% } %>
    <% if (canonicalUrl) { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>

    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_CO">
    <meta property="og:site_name" content="<%= store.name %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDesc %>">
    <% if (canonicalUrl) { %>
    <meta property="og:url" content="<%= canonicalUrl %>">
    <% } %>
    <meta property="og:image" content="<%= ogImage %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDesc %>">
    <meta name="twitter:image" content="<%= ogImage %>">

    <script type="application/ld+json"><%- storeLdJson %></script>

    <link rel="icon" href="/assets/img/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/assets/img/favicon/apple-touch-icon.png">

    <link rel="stylesheet" href="/assets/css/styles.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
    <% if (locals.extraCss && Array.isArray(extraCss)) { extraCss.forEach(function (href) { %>
    <link rel="stylesheet" href="<%= href %>">
    <% }); } %>
</head>
<body>

    <% if (locals.admin) { %>
    <div id="admin-floating-bar" style="background:#15152b; border-bottom:1px solid var(--color-accent); padding:6px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; font-size:0.85rem;">
        <span>⚡ <strong>Modo Administrador</strong> (<%= admin.email %>)</span>
        <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap;">
            <a href="/admin">Resumen</a>
            <a href="/admin/pedidos">Pedidos</a>
            <a href="/admin/pqrs">PQRS</a>
            <a href="/admin/campanas">Campañas & Cupones</a>
            <a href="/admin/inventario">Inventario</a>
            <form method="post" action="/admin/salir" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button type="submit" class="secondary" style="padding:4px 10px; font-size:0.8rem;">Salir</button>
            </form>
        </div>
    </div>
    <% } %>

    <% if (locals.flashSale && flashSale.active && Number(flashSale.percent) > 0) { %>
    <div id="flash-banner" style="background:linear-gradient(90deg,var(--color-primary),var(--color-accent)); color:#07070d; text-align:center; padding:8px 16px; font-weight:700; font-size:0.95rem; letter-spacing:0.4px;">
        ⚡ <%= flashSale.title || '¡EVENTO FLASH ACTIVO!' %> — <%= flashSale.percent %>% DE DESCUENTO EN TODA LA TIENDA ⚡
    </div>
    <% } %>

    <nav class="nav" style="position:relative;">
        <div class="nav-brand">
            <a href="/" style="display:flex; align-items:center; gap:10px;">
                <img src="/assets/img/perfil/2.webp" alt="Logo <%= store.name %>" style="height:38px; width:auto; border-radius:6px; object-fit:contain;">
                <span><%= store.name %></span>
            </a>
        </div>
        <input type="checkbox" id="nav-toggle" class="nav-toggle">
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
            <span></span>
            <span></span>
            <span></span>
        </label>
        <div class="nav-links">
            <a href="/"<%- locals.activeNav === 'inicio' ? ' aria-current="page"' : '' %>>Inicio</a>
            <a href="/catalogo"<%- locals.activeNav === 'catalogo' ? ' aria-current="page"' : '' %>>Catálogo</a>
            <a href="/spin"<%- locals.activeNav === 'spin' ? ' aria-current="page"' : '' %>>Ruleta</a>
            <a href="/carrito"<%- locals.activeNav === 'carrito' ? ' aria-current="page"' : '' %>>Carrito</a>
        </div>
    </nav>
